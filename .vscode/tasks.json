{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure PC debug",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--preset", "pc-debug"],
      "problemMatcher": []
    },
    {
      "label": "CMake: build PC debug",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--build", "--preset", "pc-debug"],
      "dependsOn": "CMake: configure PC debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: test PC debug",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/ctest",
      "args": ["--preset", "pc-debug"],
      "dependsOn": "CMake: build PC debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "CMake: build Raspberry Pi release",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--build", "--preset", "raspi-cross-release"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CMake: deploy Raspberry Pi",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--build", "--preset", "deploy-raspi"],
      "dependsOn": "CMake: build Raspberry Pi release",
      "problemMatcher": []
    },
    {
      "label": "Run: Simple Engine",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--build", "--preset", "pc-debug", "--target", "run-simple-engine"],
      "dependsOn": "CMake: build PC debug",
      "problemMatcher": []
    },
    {
      "label": "Run: OS2L Listener",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--build", "--preset", "pc-debug", "--target", "listen-os2l"],
      "dependsOn": "CMake: build PC debug",
      "problemMatcher": []
    },
    {
      "label": "Run: C++ Web UI",
      "type": "shell",
      "command": "${workspaceFolder}/.tools/cmake-python/cmake/data/bin/cmake",
      "args": ["--build", "--preset", "pc-debug", "--target", "serve-web-cpp"],
      "dependsOn": "CMake: build PC debug",
      "problemMatcher": []
    }
  ]
}
